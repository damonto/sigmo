{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sigmo-api",
  "main": "src/index.ts",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "sigmo.952007.xyz",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BOT_USERNAME": "SigmoProBot",
    "PUSH_TOPIC": "com.damon.sigmo",
    "MAINTENANCE_MODE": "false",
  },
  "triggers": {
    "crons": [
      "0 * * * *",
      "17 3 * * *"
    ],
  },
  "secrets": {
    "required": [
      "SIGMO_TELEGRAM_BOT_TOKEN",
      "SIGMO_TELEGRAM_WEBHOOK_SECRET",
      "SIGMO_LICENSE_PRIVATE_KEY",
      "SIGMO_LICENSE_PUBLIC_KEY",
      "SIGMO_CONFIG_ENCRYPTION_KEY",
      "SIGMO_RELEASE_PUBLIC_KEY",
      "SIGMO_DOWNLOAD_TICKET_SECRET",
      "SIGMO_ADMIN_TELEGRAM_IDS",
      "SIGMO_APNS_KEY_ID",
      "SIGMO_APNS_TEAM_ID",
      "SIGMO_APNS_PRIVATE_KEY",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sigmo",
      "database_id": "939c5754-8109-47b5-b7e5-3342fd20487f",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "sigmo",
      "binding": "BUCKET",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
    },
    "traces": {
      // Automatic request spans can retain OAuth callback query parameters.
      "enabled": false,
      "head_sampling_rate": 0.01,
    },
  },
}
