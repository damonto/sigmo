[Unit]
Description=Sigmo
Wants=network-online.target
After=network-online.target ModemManager.service

[Service]
Type=simple
User=root
RuntimeDirectory=sigmo
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Restart=on-failure
ExecStartPre=/bin/sh -c 'until ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; do sleep 2; done'
ExecStart=/usr/local/bin/sigmo --listen-address=0.0.0.0:9527 --db-path=/var/lib/sigmo/sigmo.db
RestartSec=10s
TimeoutStopSec=60s

[Install]
WantedBy=multi-user.target
